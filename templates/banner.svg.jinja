{#
  Profile banner: PREPARE -> MEASURE -> INFER.

  Geometry arrives precomputed from src/visualization.py; this template only
  draws. Colour roles: cryo = single-qubit work and measured probability,
  entangle = multi-qubit gates, copper = the signal path through to the answer.

  CSS here is limited to @font-face and font-family on purpose. A rule such as
  `text{font-size:10px}` would outrank every font-size presentation attribute
  below it (CSS beats presentation attributes), silently flattening the type
  scale. Sizes are therefore attributes only, inherited from the root <svg>.
#}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h }}"
     viewBox="0 0 {{ w }} {{ h }}" font-size="10" font-weight="400" role="img"
     aria-label="Jorge Menjivar. {{ measure_note }}. Inferred state: {{ action }}.">
  <title>Jorge Menjivar — inferred state: {{ action }}</title>
  <style><![CDATA[
    {{ font_faces | safe }}
    text{font-family:'SCP',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
  ]]></style>

  <rect width="{{ w }}" height="{{ h }}" fill="{{ c.canvas }}"/>

  <!-- ================================================== header ========== -->
  <text x="{{ left }}" y="22">
    <tspan fill="{{ c.ink }}" font-size="15" font-weight="600"
           letter-spacing="2.2">JORGE MENJIVAR</tspan>
    <tspan fill="{{ c.hairline }}" font-size="13" dx="16">/</tspan>
    <tspan fill="{{ c.muted }}" font-size="11" dx="14"
           letter-spacing="0.5">quantum + AI systems</tspan>
  </text>
  <text x="{{ right }}" y="22" text-anchor="end">
    <tspan fill="{{ c.muted }}" font-size="9" letter-spacing="1.5">LAST MEASURED</tspan>
    <tspan fill="{{ c.ink }}" font-size="10.5" dx="11">{{ timestamp }}</tspan>
  </text>
  <line x1="{{ left }}" y1="{{ rule_top }}" x2="{{ right }}" y2="{{ rule_top }}"
        stroke="{{ c.hairline }}" stroke-width="1"/>

  <!-- Section labels double as the pipeline; the arrows below carry the order,
       so no 01/02/03 numbering is needed. -->
  <g font-size="9.5" font-weight="600" letter-spacing="1.9" fill="{{ c.copper }}">
    <text x="{{ zone_a[0] }}" y="{{ label_y }}">PREPARE</text>
    <text x="{{ zone_b[0] }}" y="{{ label_y }}">MEASURE</text>
    <text x="{{ zone_c[0] }}" y="{{ label_y }}">INFER</text>
  </g>

  <g fill="none" stroke="{{ c.muted }}" stroke-width="1.1"
     stroke-linecap="round" stroke-linejoin="round">
    <path d="M292 {{ flow_y }} h12 m-4 -4 l4 4 l-4 4"/>
    <path d="M600 {{ flow_y }} h12 m-4 -4 l4 4 l-4 4"/>
  </g>

  <!-- ================================================= PREPARE ========== -->
  {% for y in rows_a %}
  <text x="{{ left }}" y="{{ y + 3.5 }}" fill="{{ c.ink }}">q{{ loop.index0 }}</text>
  <line x1="{{ wire_x0 }}" y1="{{ y }}" x2="{{ wire_x1 }}" y2="{{ y }}"
        stroke="{{ c.wire }}" stroke-width="1.25"/>
  {% endfor %}

  {% for g in columns %}
    {% if g.kind == 'box' %}
  <rect x="{{ g.x }}" y="{{ g.y }}" width="{{ gate_w }}" height="{{ gate_h }}"
        rx="2" fill="{{ c.canvas }}" stroke="{{ c.cryo }}" stroke-width="1.4"/>
  <text x="{{ g.cx }}" y="{{ g.text_y }}" text-anchor="middle" font-weight="600"
        font-size="{{ 9.5 if g.label|length > 1 else 11 }}"
        fill="{{ c.cryo }}">{{ g.label }}</text>
      {% if g.note %}
  <text x="{{ g.cx }}" y="{{ g.note_y }}" font-size="8.5" text-anchor="middle"
        fill="{{ c.muted }}">{{ g.note }}</text>
      {% endif %}

    {% elif g.kind == 'multi' %}
  <line x1="{{ g.cx }}" y1="{{ g.y0 }}" x2="{{ g.cx }}" y2="{{ g.y1 }}"
        stroke="{{ c.entangle }}" stroke-width="1.4"/>
      {% for cy in g.controls_y %}
  <circle cx="{{ g.cx }}" cy="{{ cy }}" r="3.6" fill="{{ c.entangle }}"/>
      {% endfor %}
  <circle cx="{{ g.cx }}" cy="{{ g.target_y }}" r="7" fill="{{ c.canvas }}"
          stroke="{{ c.entangle }}" stroke-width="1.4"/>
  <path d="M{{ g.cx - 7 }} {{ g.target_y }} h14 M{{ g.cx }} {{ g.target_y - 7 }} v14"
        stroke="{{ c.entangle }}" stroke-width="1.4"/>

    {% else %}
      {% for b in g.boxes %}
  <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ gate_w }}" height="{{ gate_h }}"
        rx="2" fill="{{ c.canvas }}" stroke="{{ c.copper }}" stroke-width="1.4"/>
  <text x="{{ g.cx }}" y="{{ b.text_y }}" text-anchor="middle" font-size="11"
        font-weight="600" fill="{{ c.copper }}">M</text>
      {% endfor %}
    {% endif %}
  {% endfor %}

  <text x="{{ zone_a[0] }}" y="{{ sublabel_y }}" font-size="9.5"
        fill="{{ c.muted }}">{{ prepare_note }}</text>

  <!-- ================================================= MEASURE ========== -->
  {% for r in histogram %}
  <g stroke="{{ c.muted }}" stroke-width="1.1" fill="none"
     stroke-linecap="round" stroke-linejoin="round">
    <path d="{{ r.ket_open }}"/>
    <path d="{{ r.ket_close }}"/>
  </g>
  <text x="{{ ket_digits_x }}" y="{{ r.text_y }}" fill="{{ c.ink }}">{{ r.bits }}</text>
  <rect x="{{ bar_x }}" y="{{ r.bar_y }}" width="{{ bar_w }}" height="{{ bar_h }}"
        rx="1" fill="{{ c.track }}"/>
  <rect x="{{ bar_x }}" y="{{ r.bar_y }}" width="{{ '%.2f'|format(r.width) }}"
        height="{{ bar_h }}" rx="1" fill="{{ c.cryo }}"/>
  <text x="{{ pct_x }}" y="{{ r.text_y }}" text-anchor="end"
        fill="{{ c.ink }}">{{ r.pct }}</text>
  {% endfor %}

  <text x="{{ zone_b[0] }}" y="{{ sublabel_y }}" font-size="9.5"
        fill="{{ c.muted }}">{{ measure_note }}</text>

  <!-- =================================================== INFER ========== -->
  <line x1="{{ '%.2f'|format(threshold_x) }}" y1="84"
        x2="{{ '%.2f'|format(threshold_x) }}" y2="198"
        stroke="{{ c.muted }}" stroke-width="1" stroke-dasharray="2 3"/>
  {% for n in neurons %}
  <text x="{{ neuron_x }}" y="{{ n.text_y }}" fill="{{ c.muted }}">{{ n.label }}</text>
  <rect x="{{ meter_x }}" y="{{ n.meter_y }}" width="{{ meter_w }}"
        height="{{ meter_h }}" rx="1" fill="{{ c.track }}"/>
  <rect x="{{ meter_x }}" y="{{ n.meter_y }}" width="{{ '%.2f'|format(n.width) }}"
        height="{{ meter_h }}" rx="1" fill="{{ c.cryo }}"/>
  <text x="{{ value_x }}" y="{{ n.text_y }}" text-anchor="end"
        fill="{{ c.ink }}">{{ n.value }}</text>
  <text x="{{ bit_x }}" y="{{ n.text_y + 1 }}" text-anchor="end" font-size="13"
        font-weight="600"
        fill="{{ c.copper if n.on else c.muted }}">{{ n.bit }}</text>
  {% endfor %}

  <text x="{{ zone_c[0] }}" y="{{ sublabel_y }}" font-size="9.5"
        fill="{{ c.muted }}">{{ infer_note }}</text>

  <!-- ================================================== readout ========= -->
  <line x1="{{ left }}" y1="{{ rule_bottom }}" x2="{{ right }}" y2="{{ rule_bottom }}"
        stroke="{{ c.hairline }}" stroke-width="1"/>
  <g font-size="9" letter-spacing="1.6" fill="{{ c.muted }}">
    <text x="{{ left }}" y="262">INFERRED STATE</text>
    <text x="{{ right }}" y="262" text-anchor="end">{{ cadence }}</text>
  </g>
  <text x="{{ left }}" y="294" font-size="26" font-weight="600"
        fill="{{ c.ink }}">{{ action }}</text>
</svg>
